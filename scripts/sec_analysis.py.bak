#!/usr/bin/env python3
"""
SEC Filing Analysis - 分析下载的 SEC 财报
从 10-K/10-Q 中提取关键章节，生成中文分析报告
"""

import argparse
import os
import re
import sys
from datetime import datetime
from html.parser import HTMLParser

REPORTS_DIR = os.path.expanduser("~/.openclaw/reports/sec_filings/")

# 关键章节标题模式（不区分大小写）
# 10-K 和 10-Q 的章节结构不同
SECTION_PATTERNS = {
    "business": [
        r"item\s*1[.\s:—–-]+\s*business",  # 10-K 专用
        r"business\s+overview",
        r"segment\s+information",  # 10-Q 中的业务分部信息
    ],
    "risk_factors": [
        r"item\s*1a[.\s:—–-]+\s*risk\s+factors",
        r"risk\s+factors",
    ],
    "mda": [
        r"item\s*7[.\s:—–-]+\s*management.*?discussion",
        r"management.*?discussion.*?analysis",
        r"md&a",
    ],
    "financials": [
        r"item\s*8[.\s:—–-]+\s*financial\s+statements",  # 10-K
        r"item\s*1[.\s:—–-]+\s*condensed\s+consolidated\s+financial",  # 10-Q
        r"condensed\s+consolidated\s+statements\s+of\s+operations",
        r"consolidated\s+statements\s+of\s+operations",
    ],
    "earnings": [
        r"earnings\s+per\s+share",
        r"diluted\s+earnings\s+per\s+share",
    ],
}


class HTMLTextExtractor(HTMLParser):
    """从 HTML 提取纯文本"""

    def __init__(self):
        super().__init__()
        self.result = []
        self.skip_tags = {"script", "style", "head"}
        self.current_tag = None

    def handle_starttag(self, tag, attrs):
        self.current_tag = tag
        if tag in self.skip_tags:
            self.skip = True

    def handle_endtag(self, tag):
        if tag in self.skip_tags:
            self.skip = False
        self.current_tag = None

    def handle_data(self, data):
        if not hasattr(self, "skip") or not self.skip:
            text = data.strip()
            if text:
                self.result.append(text)

    def get_text(self):
        return " ".join(self.result)


def extract_text_from_html(html_content):
    """从 HTML 内容提取纯文本"""
    extractor = HTMLTextExtractor()
    try:
        extractor.feed(html_content)
        return extractor.get_text()
    except Exception:
        # 如果解析失败，用正则简单去除标签
        text = re.sub(r"<[^>]+>", " ", html_content)
        text = re.sub(r"\s+", " ", text)
        return text.strip()


def find_body_start(text):
    """找到正文开始位置，跳过目录"""
    # 方法1: 找到 "PART I" 或 "PART 1" 后面的 "Item 1"
    part_markers = [
        r"part\s+[iI1][\s.:—–-]",
        r"item\s+1[\s.:—–-]+\s*business",
    ]

    for pattern in part_markers:
        matches = list(re.finditer(pattern, text, re.IGNORECASE))
        if matches:
            # 取最后一个匹配（目录中可能有多个，正文中的通常在后面）
            return matches[-1].start()

    # 方法2: 跳过前 15000 字符（目录通常不会超过这个长度）
    return min(15000, len(text) // 4)


def find_sections(text, section_type, start_from=0):
    """在文本中查找关键章节，从 start_from 位置开始"""
    patterns = SECTION_PATTERNS.get(section_type, [])
    search_text = text[start_from:]

    for pattern in patterns:
        matches = list(re.finditer(pattern, search_text, re.IGNORECASE))
        if matches:
            # 返回第一个匹配的位置（加上 start_from 偏移）
            return start_from + matches[0].start()
    return -1


def extract_section_content(text, start_pos, max_chars=5000):
    """从指定位置提取章节内容"""
    if start_pos < 0:
        return ""

    # 从 start_pos 开始，提取到下一个主要章节或 max_chars
    end_markers = [
        r"item\s+\d+[a-z]?[.\s:—–-]",
        r"part\s+[ivx]+",
        r"table\s+of\s+contents",
    ]

    end_pos = min(start_pos + max_chars, len(text))

    # 尝试找到下一个章节的开始
    for marker in end_markers:
        matches = list(re.finditer(marker, text[start_pos + 100:], re.IGNORECASE))
        if matches:
            candidate_end = start_pos + 100 + matches[0].start()
            if candidate_end < end_pos:
                end_pos = candidate_end
                break

    content = text[start_pos:end_pos]
    # 清理多余空白
    content = re.sub(r"\s+", " ", content).strip()
    return content


def extract_key_metrics(text):
    """从文本中提取关键财务指标"""
    metrics = {}

    # 清理 HTML 实体
    clean_text = text.replace("&#160;", " ").replace("&nbsp;", " ")
    clean_text = re.sub(r"\s+", " ", clean_text)

    # 营收模式 - Total revenues 12,252
    revenue_patterns = [
        r"Total\s+revenues?\s+\$?\s*([\d,]+)",
        r"(?:total\s+)?(?:net\s+)?revenues?\s*[:\$]\s*([\d,]+)",
    ]

    # 净利润模式 - Net income $ 3,004
    income_patterns = [
        r"Net\s+income\s+\$?\s*([\d,]+)",
        r"net\s+(?:income|loss)\s*[:\$]\s*([\d,]+)",
    ]

    # EPS 模式 - Basic earnings per share $ 2.81
    eps_patterns = [
        r"(?:Basic|Diluted)\s+earnings\s+per\s+share\s+\$?\s*([\d.]+)",
        r"earnings\s+per\s+share\s*[:\$]\s*([\d.]+)",
    ]

    # 营收
    for pattern in revenue_patterns:
        match = re.search(pattern, clean_text, re.IGNORECASE)
        if match:
            value = match.group(1).replace(",", "")
            metrics["revenue"] = f"${int(value):,}M"
            break

    # 净利润
    for pattern in income_patterns:
        match = re.search(pattern, clean_text, re.IGNORECASE)
        if match:
            value = match.group(1).replace(",", "")
            metrics["net_income"] = f"${int(value):,}M"
            break

    # EPS
    for pattern in eps_patterns:
        match = re.search(pattern, clean_text, re.IGNORECASE)
        if match:
            metrics["eps"] = f"${match.group(1)}"
            break

    return metrics


def analyze_filing(filing_path, output_format="text"):
    """分析单个 SEC filing"""
    if not os.path.exists(filing_path):
        print(f"❌ 文件不存在: {filing_path}")
        return None

    print(f"📄 正在分析: {os.path.basename(filing_path)}")

    # 读取文件
    try:
        with open(filing_path, "r", encoding="utf-8", errors="ignore") as f:
            html_content = f.read()
    except Exception as e:
        print(f"❌ 读取文件失败: {e}")
        return None

    # 提取纯文本
    text = extract_text_from_html(html_content)
    print(f"   文本长度: {len(text):,} 字符")

    # 找到正文开始位置，跳过目录
    body_start = find_body_start(text)
    print(f"   正文开始位置: {body_start:,}")

    # 提取各章节
    analysis = {
        "file": os.path.basename(filing_path),
        "size": os.path.getsize(filing_path),
        "sections": {},
        "metrics": {},
    }

    for section_type, _ in SECTION_PATTERNS.items():
        pos = find_sections(text, section_type, start_from=body_start)
        if pos >= 0:
            content = extract_section_content(text, pos)
            analysis["sections"][section_type] = {
                "found": True,
                "position": pos,
                "content": content[:2000] + "..." if len(content) > 2000 else content,
                "full_length": len(content),
            }
            print(f"   ✅ 找到 {section_type} ({len(content):,} 字符)")
        else:
            analysis["sections"][section_type] = {"found": False}
            print(f"   ⚠️  未找到 {section_type}")

    # 提取关键指标
    analysis["metrics"] = extract_key_metrics(text)
    if analysis["metrics"]:
        print(f"   ✅ 找到 {len(analysis['metrics'])} 个关键指标")

    return analysis


def generate_summary(analysis, ticker):
    """生成简要总结"""
    metrics = analysis.get("metrics", {})
    summary = []

    summary.append(f"### 📊 {ticker} 财报摘要")
    summary.append("")

    # 关键指标表格
    if metrics:
        summary.append("| 指标 | 数值 |")
        summary.append("|:---|:---|")
        if "revenue" in metrics:
            summary.append(f"| 营收 | {metrics['revenue']} |")
        if "net_income" in metrics:
            summary.append(f"| 净利润 | {metrics['net_income']} |")
        if "eps" in metrics:
            summary.append(f"| 每股收益 (EPS) | {metrics['eps']} |")
        summary.append("")

    # 章节发现统计
    sections = analysis.get("sections", {})
    found_sections = [k for k, v in sections.items() if v.get("found")]
    missing_sections = [k for k, v in sections.items() if not v.get("found")]

    summary.append(f"**章节覆盖**: {len(found_sections)}/{len(sections)} 个章节已提取")
    if missing_sections:
        section_names = {
            "business": "业务概述",
            "risk_factors": "风险因素",
            "mda": "管理层讨论",
            "financials": "财务报表",
            "earnings": "每股收益",
        }
        missing_names = [section_names.get(s, s) for s in missing_sections]
        summary.append(f"**缺失章节**: {', '.join(missing_names)}")
    summary.append("")

    return "\n".join(summary)


def generate_report(analyses, ticker):
    """生成分析报告"""
    report = []
    report.append(f"# {ticker} SEC 财报分析报告")
    report.append(f"生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    report.append("")

    for analysis in analyses:
        report.append(f"## 📄 {analysis['file']}")
        report.append(f"文件大小: {analysis['size']:,} 字节")
        report.append("")

        # 添加摘要
        report.append(generate_summary(analysis, ticker))

        # 关键指标
        if analysis["metrics"]:
            report.append("### 关键财务指标")
            for key, value in analysis["metrics"].items():
                report.append(f"- **{key}**: {value}")
            report.append("")

        # 各章节摘要
        report.append("### 章节分析")
        for section_type, section_data in analysis["sections"].items():
            section_names = {
                "business": "业务概述",
                "risk_factors": "风险因素",
                "mda": "管理层讨论与分析",
                "financials": "财务报表",
                "earnings": "每股收益",
            }
            name = section_names.get(section_type, section_type)

            if section_data["found"]:
                report.append(f"#### {name}")
                report.append(f"长度: {section_data['full_length']:,} 字符")
                report.append("")
                # 取前 500 字符作为摘要
                summary = section_data["content"][:500]
                if len(section_data["content"]) > 500:
                    summary += "..."
                report.append(f"> {summary}")
                report.append("")
            else:
                report.append(f"#### {name}")
                report.append("*未找到相关章节*")
                report.append("")

        report.append("---")
        report.append("")

    return "\n".join(report)


def find_latest_filing(ticker, form_type=None):
    """查找最新的 filing 文件"""
    ticker_dir = os.path.join(REPORTS_DIR, ticker.upper())
    if not os.path.exists(ticker_dir):
        print(f"❌ 未找到 {ticker} 的财报目录: {ticker_dir}")
        return None

    # 查找所有 .htm 文件
    htm_files = []
    for f in os.listdir(ticker_dir):
        if f.endswith(".htm") and not f.endswith("_index.html"):
            filepath = os.path.join(ticker_dir, f)
            mtime = os.path.getmtime(filepath)
            htm_files.append((filepath, mtime, f))

    if not htm_files:
        print(f"❌ {ticker} 目录中没有 .htm 文件")
        return None

    # 按修改时间排序，最新的在前
    htm_files.sort(key=lambda x: x[1], reverse=True)

    # 如果指定了表单类型，尝试过滤
    if form_type:
        for filepath, mtime, filename in htm_files:
            if form_type.lower() in filename.lower():
                return filepath

    # 返回最新的文件
    return htm_files[0][0]


def main():
    parser = argparse.ArgumentParser(description="SEC Filing Analysis - 分析 SEC 财报")
    parser.add_argument("input", help="Ticker symbol (e.g., QCOM) or filing path")
    parser.add_argument("--form", help="Form type filter (10-K, 10-Q, etc.)")
    parser.add_argument("--output", choices=["text", "json"], default="text", help="Output format")
    parser.add_argument("--output-file", help="Output file path")

    args = parser.parse_args()

    # 判断输入是 ticker 还是文件路径
    if os.path.exists(args.input):
        filing_path = args.input
        ticker = os.path.basename(os.path.dirname(filing_path))
    else:
        ticker = args.input.upper()
        filing_path = find_latest_filing(ticker, args.form)

    if not filing_path:
        print("❌ 未找到可分析的财报文件")
        sys.exit(1)

    # 分析文件
    analysis = analyze_filing(filing_path, args.output)
    if not analysis:
        sys.exit(1)

    # 生成报告
    report = generate_report([analysis], ticker)

    # 输出报告
    if args.output_file:
        os.makedirs(os.path.dirname(args.output_file), exist_ok=True)
        with open(args.output_file, "w", encoding="utf-8") as f:
            f.write(report)
        print(f"\n✅ 报告已保存: {args.output_file}")
    else:
        print("\n" + report)


if __name__ == "__main__":
    main()
